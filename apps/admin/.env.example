# Varsayılan: frontend modül tercihlerini oturumluk mock sağlayıcıdan okur.
VITE_FEATURE_PROVIDER=mock
# Katalog yalnız PostgreSQL modundaki yerel API'den okunacaksa http yapın.
VITE_CATALOG_PROVIDER=mock
# Satış ekranı varsayılan olarak örnek veri gösterir; gerçek PostgreSQL siparişlerini okumak için http yapın.
VITE_SALES_PROVIDER=mock
# Yerel ASP.NET Core prototipini açmak için değeri http yapın.
# İki sağlayıcı da http ise taslak kayıtları gerçek yerel API'ye gönderilir.
# Varsayılan API adresi http://127.0.0.1:5180; yalnız özel test/kurulumda değiştirin.
# VITE_API_BASE_URL=http://127.0.0.1:5180
